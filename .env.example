# Copy this file to backend/.env (the API server loads .env from its working
# directory) and replace the placeholder values. Never commit the real .env.

# Server
PORT=3001

# Database Configuration
# URL-encode special characters in the password (e.g. "@" becomes "%40").
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/business_discovery_outreach

# SMTP / Email Configuration (Nodemailer / Mailercloud)
# If SMTP_HOST, SMTP_USER or SMTP_PASS is left blank, Nodemailer automatically
# generates an Ethereal test account and prints preview links instead of sending.
SMTP_HOST=smtp-prod.mailrcld.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-generated-smtp-password
MAILERCLOUD_CAMPAIGN_ID=leadstream-outreach

# Twilio Configuration (SMS & WhatsApp)
# If these are left blank, Twilio dispatches will be simulated in the console logs.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Scraper: contact address sent in the Overpass API User-Agent, as requested by
# the Overpass usage policy so operators can reach you about heavy usage.
SCRAPER_CONTACT_EMAIL=you@example.com
